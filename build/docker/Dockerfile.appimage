# syntax=docker/dockerfile:1.7

ARG GO_VERSION=1.27.0
ARG NODE_VERSION=24.18.0

FROM golang:${GO_VERSION}-bookworm AS go-toolchain

# Ubuntu 22.04 keeps the produced binary compatible with an older glibc than
# current Linux images. Wails' GTK3 path is used for the same compatibility
# reason; the finished AppImage still contains the GTK/WebKit runtime files
# collected by `wails3 generate appimage`.
FROM ubuntu:22.04 AS linux-builder

ARG TARGETARCH
ARG WAILS_LINUX_TAGS=gtk3

ENV DEBIAN_FRONTEND=noninteractive \
    CI=1 \
    CGO_ENABLED=1 \
    GOARCH=amd64 \
    GOOS=linux \
    GOPATH=/go \
    GOTOOLCHAIN=local \
    PATH=/usr/local/go/bin:/go/bin:/usr/local/bin:/usr/bin:/bin

COPY --from=go-toolchain /usr/local/go/ /usr/local/go/

RUN test "${TARGETARCH}" = "amd64" || { \
      echo "Dockerfile.appimage only builds linux/amd64 (got: ${TARGETARCH})" >&2; \
      exit 1; \
    } \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
      binutils \
      build-essential \
      ca-certificates \
      curl \
      desktop-file-utils \
      dpkg-dev \
      file \
      git \
      libgirepository1.0-dev \
      libglib2.0-bin \
      libgtk-3-dev \
      librsvg2-dev \
      libwebkit2gtk-4.1-dev \
      pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Build the CLI from the same local Wails checkout used by the application.
# The CLI itself must use the GTK3 tag because the amd64 stage deliberately
# installs WebKitGTK 4.1 rather than the newer GTK4/WebKitGTK 6 stack.
COPY wails/v3/ /workspace/wails/v3/
WORKDIR /workspace/wails/v3
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go install -tags gtk3 ./cmd/wails3

# Preserve the host workspace layout because go.work, go.mod replacements, and
# the frontend's local @wailsio/runtime dependency all use sibling paths.
COPY ctap/ /workspace/ctap/
COPY hid/ /workspace/hid/
COPY kit/ /workspace/kit/
COPY token2/ /workspace/token2/
COPY app/ /workspace/app/

# Bindings come from the target Wails/Go toolchain, but they are plain
# TypeScript and can then be consumed by a native-architecture Node stage.
WORKDIR /workspace/app
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go mod tidy \
    && wails3 generate bindings \
      -f "-tags production,${WAILS_LINUX_TAGS} -trimpath -buildvcs=false -ldflags=\"-w -s\"" \
      -clean=true \
      -ts

# Vite and its native helpers are unreliable under QEMU on Apple Silicon.
# Build the architecture-independent web assets on the Podman machine's native
# architecture, then copy only frontend/dist back into the amd64 Linux stage.
FROM --platform=${BUILDPLATFORM} node:${NODE_VERSION}-bullseye-slim AS frontend-builder

ARG PNPM_VERSION=11.15.0

ENV CI=1

RUN npm install --global "pnpm@${PNPM_VERSION}"

COPY --from=linux-builder /workspace/wails/v3/ /workspace/wails/v3/
COPY --from=linux-builder /workspace/app/ /workspace/app/

WORKDIR /workspace/app/frontend
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install \
    && pnpm run build

FROM linux-builder AS appimage-builder

ARG APP_NAME=telesma
ARG WAILS_LINUX_TAGS

COPY app/build/docker/linuxdeploy-extracted-wrapper.sh /usr/local/bin/linuxdeploy-extracted-wrapper
COPY --from=frontend-builder /workspace/app/frontend/dist/ /workspace/app/frontend/dist/

RUN apt-get update \
    && apt-get install -y --no-install-recommends squashfs-tools \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/app
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go build \
      -tags "production,${WAILS_LINUX_TAGS}" \
      -trimpath \
      -buildvcs=false \
      -ldflags="-w -s" \
      -o "bin/${APP_NAME}"

RUN mkdir -p build/linux/appimage/build \
    && curl -fsSL \
      https://github.com/linuxdeploy/linuxdeploy/releases/download/continuous/linuxdeploy-x86_64.AppImage \
      -o build/linux/appimage/build/linuxdeploy-x86_64.real.AppImage \
    && squashfs_offset="$(grep -abo hsqs build/linux/appimage/build/linuxdeploy-x86_64.real.AppImage | tail -n 1 | cut -d: -f1)" \
    && test -n "${squashfs_offset}" \
    && unsquashfs \
      -quiet \
      -offset "${squashfs_offset}" \
      -dest build/linux/appimage/build/linuxdeploy-extracted \
      build/linux/appimage/build/linuxdeploy-x86_64.real.AppImage \
    && install -m 0755 \
      /usr/local/bin/linuxdeploy-extracted-wrapper \
      build/linux/appimage/build/linuxdeploy-x86_64.AppImage \
    && wails3 generate .desktop \
      -name "${APP_NAME}" \
      -exec "${APP_NAME}" \
      -icon "${APP_NAME}" \
      -outputfile "build/linux/${APP_NAME}.desktop" \
      -categories "Development;" \
    && cp "bin/${APP_NAME}" "build/linux/appimage/${APP_NAME}" \
    && cp build/appicon.png "build/linux/appimage/${APP_NAME}.png" \
    && cd build/linux/appimage \
    && wails3 generate appimage \
      -binary "${APP_NAME}" \
      -icon "${APP_NAME}.png" \
      -desktopfile "../${APP_NAME}.desktop" \
      -outputdir ../../../bin \
      -builddir /workspace/app/build/linux/appimage/build

# Podman on macOS cannot use the local build output exporter through its remote
# client. Keep the package in a tiny artifact image so the task can extract it
# with `podman cp` from a stopped, temporary container.
FROM scratch AS artifact
COPY --from=appimage-builder /workspace/app/bin/*-x86_64.AppImage /bin/
